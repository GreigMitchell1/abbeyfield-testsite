<%- include('partials/header', { title: 'Members Login' }) %>
<section class="grid">
  <div class="card" style="max-width:480px; margin: 24px auto;">
    <h2>Members Area</h2>
    <p>Please enter the password to continue.</p>
    <form method="POST" style="margin-top:12px;">
      <label for="pw" class="sr-only">Password</label>
      <input id="pw" type="password" name="password" placeholder="Password" aria-label="Password" />
      <div style="margin-top:12px;">
        <button type="submit">Login</button>
      </div>
    </form>
    <% if (error) { %>
      <p class="error" style="margin-top:10px;"><%= error %></p>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>
