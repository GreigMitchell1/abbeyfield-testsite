<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title ? title + ' | ' : '' %><%= siteName %></title>
  <meta name="description" content="<%= description %>" />
  <% if (noindex) { %><meta name="robots" content="noindex, nofollow" /><% } %>
  <meta name="theme-color" content="#003366" />
  <meta name="color-scheme" content="light dark" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <a class="skip-link" href="#content">Skip to main content</a>
  <header class="site-header">
    <div class="container brandbar">
      <a class="brand" href="/">
        <% if (hasLogo) { %><img src="/images/animated_logo.gif" alt="" height="40" /><% } %>
        <span class="title"><%= siteName %></span>
      </a>
      <nav aria-label="Primary">
        <% nav.forEach((item) => {
             const active = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href); %>
          <a href="<%= item.href %>"<% if (active) { %> aria-current="page"<% } %>><%= item.label %></a>
        <% }) %>
      </nav>
    </div>
  </header>
  <main id="content">
