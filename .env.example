# Copy to .env and fill in. Never commit the real .env file.

# Password for the members area. If empty, the members area is disabled.
MEMBER_PASSWORD=change-me

# Long random string used to sign the login cookie. Required in production.
# Generate one with (works in PowerShell, Command Prompt and bash):
#   node -p "require('crypto').randomBytes(32).toString('hex')"
SESSION_SECRET=

# Optional
PORT=3000
NODE_ENV=development
